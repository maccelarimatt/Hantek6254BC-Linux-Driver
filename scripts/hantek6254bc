#!/bin/sh
set -eu

# Resolve the source tree explicitly. This keeps the launcher reliable across
# host/sandbox Python environments and does not depend on editable-install .pth files.
project_dir="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
export PYTHONPATH="$project_dir/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$project_dir/.venv/bin/python" -m hantek6254bc.cli "$@"

